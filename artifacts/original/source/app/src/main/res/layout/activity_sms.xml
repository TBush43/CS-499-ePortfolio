<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/sms_notifications"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/allow_sms_message" />

    <Button
        android:id="@+id/allowSmsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/allow_sms" />

    <Button
        android:id="@+id/denySmsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/deny" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/status_placeholder" />

</LinearLayout>